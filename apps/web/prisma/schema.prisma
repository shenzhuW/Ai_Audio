generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScriptDocument {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @unique @map("revision_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("script_documents")
}

model ScriptSegmentVersion {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @map("revision_id") @db.Uuid
  segmentId  String           @map("segment_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([revisionId, segmentId])
  @@index([projectId])
  @@map("script_segment_versions")
}

// Phase 00 stores a validated versioned Project aggregate, including ProjectInput.
// Future artifact/revision tables must not overwrite this project's input history.
model Project {
  id                      String                   @id @db.Uuid
  ownerId                 String                   @map("owner_id")
  version                 Int
  updatedAt               String                   @map("updated_at")
  document                Json
  workflowArtifacts       WorkflowArtifact[]
  workflowRevisions       WorkflowRevision[]
  workflowDependencys     WorkflowDependency[]
  workflowApprovalEvents  WorkflowApprovalEvent[]
  workflowJobs            WorkflowJob[]
  workflowOutboxs         WorkflowOutbox[]
  workflowRequestReceipts WorkflowRequestReceipt[]
  workflowAuditEvents     WorkflowAuditEvent[]
  researchSources         ResearchSource[]
  researchClaims          ResearchClaim[]
  researchEvidence        ResearchClaimEvidence[]
  researchIndexes         ResearchIndexEntry[]
  scriptDocuments         ScriptDocument[]
  scriptSegments          ScriptSegmentVersion[]
  voiceTimelines          VoiceTimeline[]
  voiceCues               VoiceCueVersion[]
  directorDocuments       DirectorDocument[]
  directorShots           DirectorShotVersion[]
  sourceAssets SourceAsset[]
  candidateClips CandidateClip[]
  assetBindings AssetBinding[]
  preparedAssets PreparedAsset[]
  subtitleTracks          SubtitleTrack[]

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model WorkflowArtifact {
  id        String             @id @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  document  Json
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type      String
  revisions WorkflowRevision[]

  @@unique([projectId, type])
  @@index([projectId])
  @@map("workflow_artifacts")
}

model WorkflowRevision {
  id               String                  @id @db.Uuid
  projectId        String                  @map("project_id") @db.Uuid
  document         Json
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  artifactId       String                  @map("artifact_id") @db.Uuid
  revisionNumber   Int                     @map("revision_number")
  artifact         WorkflowArtifact        @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvals        WorkflowApprovalEvent[]
  inputs           WorkflowDependency[]    @relation("Downstream")
  outputs          WorkflowDependency[]    @relation("Upstream")
  researchSources  ResearchSource[]
  researchClaims   ResearchClaim[]
  researchEvidence ResearchClaimEvidence[]
  researchIndexes  ResearchIndexEntry[]
  scriptDocuments  ScriptDocument[]
  scriptSegments   ScriptSegmentVersion[]
  voiceTimelines   VoiceTimeline[]         @relation("VoiceSnapshot")
  voiceInputs      VoiceTimeline[]         @relation("VoiceScript")
  voiceCues        VoiceCueVersion[]
  directorSnapshots DirectorDocument[] @relation("DirectorSnapshot")
  directorScriptInputs DirectorDocument[] @relation("DirectorScript")
  directorVoiceInputs DirectorDocument[] @relation("DirectorVoice")
  candidateClips CandidateClip[]
  assetBindings AssetBinding[]
  directorShots DirectorShotVersion[]
  subtitleTracks   SubtitleTrack[]

  @@unique([artifactId, revisionNumber])
  @@index([projectId])
  @@map("workflow_revisions")
}

model VoiceTimeline {
  id               String           @id @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  revisionId       String           @unique @map("revision_id") @db.Uuid
  scriptRevisionId String           @map("script_revision_id") @db.Uuid
  document         Json
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision         WorkflowRevision @relation("VoiceSnapshot", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scriptRevision   WorkflowRevision @relation("VoiceScript", fields: [scriptRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("voice_timelines")
}

model VoiceCueVersion {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @map("revision_id") @db.Uuid
  cueId      String           @map("cue_id") @db.Uuid
  anchorId   String           @map("anchor_id") @db.Uuid
  segmentId  String           @map("segment_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([revisionId, cueId])
  @@unique([revisionId, anchorId])
  @@index([projectId])
  @@map("voice_cue_versions")
}

model SubtitleTrack {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @unique @map("revision_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("subtitle_tracks")
}

model WorkflowDependency {
  id                   String           @id @db.Uuid
  projectId            String           @map("project_id") @db.Uuid
  document             Json
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  upstreamRevisionId   String           @map("upstream_revision_id") @db.Uuid
  downstreamRevisionId String           @map("downstream_revision_id") @db.Uuid
  upstream             WorkflowRevision @relation("Upstream", fields: [upstreamRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  downstream           WorkflowRevision @relation("Downstream", fields: [downstreamRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([upstreamRevisionId, downstreamRevisionId])
  @@index([projectId])
  @@map("workflow_dependencies")
}

model WorkflowApprovalEvent {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revisionId String           @map("revision_id") @db.Uuid
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("workflow_approval_events")
}

model WorkflowJob {
  id        String          @id @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  document  Json
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state     String
  outbox    WorkflowOutbox?

  @@index([state])
  @@index([projectId])
  @@map("workflow_jobs")
}

model WorkflowOutbox {
  id        String      @id @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  document  Json
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  jobId     String      @unique @map("job_id") @db.Uuid
  job       WorkflowJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("workflow_outbox")
}

model WorkflowRequestReceipt {
  id        String  @id @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  document  Json
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  key       String  @map("idempotency_key")

  @@unique([projectId, key])
  @@index([projectId])
  @@map("workflow_request_receipts")
}

model WorkflowAuditEvent {
  id        String  @id @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  document  Json
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("workflow_audit_events")
}

model ResearchSource {
  id         String                  @id @db.Uuid
  projectId  String                  @map("project_id") @db.Uuid
  revisionId String                  @map("revision_id") @db.Uuid
  document   Json
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence   ResearchClaimEvidence[]
  indexes    ResearchIndexEntry[]

  @@unique([id, revisionId])
  @@index([projectId])
  @@map("research_sources")
}

model ResearchClaim {
  id         String                  @id @db.Uuid
  projectId  String                  @map("project_id") @db.Uuid
  revisionId String                  @map("revision_id") @db.Uuid
  document   Json
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence   ResearchClaimEvidence[]

  @@unique([id, revisionId])
  @@index([projectId])
  @@map("research_claims")
}

model ResearchClaimEvidence {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @map("revision_id") @db.Uuid
  claimId    String           @map("claim_id") @db.Uuid
  sourceId   String           @map("source_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  claim      ResearchClaim    @relation(fields: [claimId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Cascade)
  source     ResearchSource   @relation(fields: [sourceId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("research_claim_evidence")
}

model ResearchIndexEntry {
  id         String           @id @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  revisionId String           @map("revision_id") @db.Uuid
  sourceId   String           @map("source_id") @db.Uuid
  document   Json
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision   WorkflowRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source     ResearchSource   @relation(fields: [sourceId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("research_index_entries")
}

model DirectorDocument {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 revisionId String @unique @map("revision_id") @db.Uuid
 scriptRevisionId String @map("script_revision_id") @db.Uuid
 voiceRevisionId String @map("voice_revision_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 revision WorkflowRevision @relation("DirectorSnapshot",fields:[revisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 scriptRevision WorkflowRevision @relation("DirectorScript",fields:[scriptRevisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 voiceRevision WorkflowRevision @relation("DirectorVoice",fields:[voiceRevisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 @@index([projectId])
 @@map("director_documents")
}
model DirectorShotVersion {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 revisionId String @map("revision_id") @db.Uuid
 shotId String @map("shot_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 revision WorkflowRevision @relation(fields:[revisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 @@unique([revisionId,shotId])
 @@index([projectId])
 @@map("director_shot_versions")
}

model SourceAsset {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 candidates CandidateClip[]
 bindings AssetBinding[]
 @@index([projectId])
 @@map("source_assets")
}
model CandidateClip {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 directorRevisionId String @map("director_revision_id") @db.Uuid
 sourceAssetId String @map("source_asset_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 director WorkflowRevision @relation(fields:[directorRevisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 source SourceAsset @relation(fields:[sourceAssetId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 bindings AssetBinding[]
 @@index([projectId])
 @@map("candidate_clips")
}
model AssetBinding {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 directorRevisionId String @map("director_revision_id") @db.Uuid
 shotId String @map("shot_id") @db.Uuid
 version Int @map("binding_version")
 sourceAssetId String @map("source_asset_id") @db.Uuid
 candidateId String @map("candidate_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 director WorkflowRevision @relation(fields:[directorRevisionId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 source SourceAsset @relation(fields:[sourceAssetId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 candidate CandidateClip @relation(fields:[candidateId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 prepared PreparedAsset[]
 @@unique([projectId,directorRevisionId,shotId,version])
 @@index([projectId])
 @@map("asset_bindings")
}
model PreparedAsset {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 recipeHash String @map("recipe_hash")
 producerBindingId String @map("producer_binding_id") @db.Uuid
 document Json
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 binding AssetBinding @relation(fields:[producerBindingId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 @@unique([projectId,recipeHash])
 @@index([projectId])
 @@map("prepared_assets")
}
