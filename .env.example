# 复制到 apps/web/.env.local。以下本地默认值无需外部服务。
# 数据与会话密钥保存在 apps/web/.data；仅本机 loopback 访问。
STUDIO_DATA_DIR=.data
STUDIO_MAX_DURATION_SECONDS=3600
STUDIO_MAX_UPLOAD_MB=10
# Phase 00.5 已验证真实 PostgreSQL + Prisma；不设置仍使用 SQLite。
# 切换时请使用独立原件目录（如 .data/postgresql），保留 SQLite 源文件。
# 配置后先执行 pnpm db:generate 与 pnpm db:migrate；绝不提交真实凭据。
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_code_video
# 模型提供方仍为预留；Phase 02 的可信 Remotion 渲染由独立 Worker 执行。
BLOB_STORAGE_DRIVER=local
MEDIA_ROOT=./.local-media
MODEL_PROVIDER=mock
SEARCH_PROVIDER=mock
TTS_PROVIDER=mock
# OPENAI_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
RENDER_MAX_CONCURRENCY=1
# 本阶段每个 Render Worker 固定串行；全局多实例并发调度留后续。
# 仅本机可信预置子进程模式，不能执行任意 TSX；显式设为 1 才允许执行。
STUDIO_TRUSTED_LOCAL_RENDER=0
# Phase 03：研究解析器只在独立 Worker 执行，不开放任意代码。
STUDIO_RESEARCH_MAX_VIDEO_SECONDS=120
STUDIO_RESEARCH_MAX_PDF_PAGES=50
# STUDIO_FFMPEG_PATH=C:/path/to/ffmpeg.exe
# STUDIO_CHROMIUM_PATH=C:/path/to/chrome.exe
# STUDIO_FFPROBE_PATH=C:/path/to/ffprobe.exe
# 以下为后续容器策略预留，本机可信子进程不提供 OS 级网络隔离。
WORKER_NETWORK_DEFAULT=deny
APP_MODE=development
# Phase 04.5：显式启用本机已登录 ChatGPT 的 Codex 0.163.0 数据分析。
# API 和对应 Worker 均设置；不复制/打印 auth.json，不需要额外搜索 API Key。
STUDIO_CODEX_ENABLED=0
# Phase05: trusted Windows system TTS; does not grant any new Codex tools.
STUDIO_SYSTEM_TTS_ENABLED=0
# Optional local Whisper/stable-ts CPU inference. Run setup first; no runtime model downloads.
STUDIO_SPEECH_ENABLED=0
STUDIO_SPEECH_MAX_SECONDS=600
STUDIO_SPEECH_TIMEOUT_MS=600000
# STUDIO_SPEECH_PYTHON=C:/path/to/project-local/python.exe
# STUDIO_WHISPER_MODEL_PATH=C:/path/to/verified/base.pt
# 可选：可信本机 codex.exe 绝对路径；用户输入不能设置此值。
# STUDIO_CODEX_BINARY=C:/path/to/codex.exe
